extends ../layouts/main-template

block vars
    - const header = true;
    - const footer = true;
    - var currentUrl = 'faq.html';

block title
    title FAQ — Blackgrow

block description
    meta(name='description', content='FAQ — Blackgrow.')

block content
    -
        const faqList = [
            'WHERE CAN I PURCHASE YOUR PRODUCTS?',
            'HOW DO I REGISTER ON THE ONLINE SHOP?',
            'HOW CAN I PAY THE PURCASE ONLINE?',
            'CAN I USE PAYPAL FOR CHECKOUT?',
            'HOW CAN I CONTACT YOU?',
            'WHICH ARE YOUR PREMIUM CRIBS?',
            'WHAT MATRACES DO YOU USE?'
        ];
        const faqAnswer = 'Cursus mattis molestie a iaculis at erat pellentesque adipiscing. Ipsum faucibus vitae aliquet ullamcor si Tempus quam pellentesque nec nam aliquam sem et tortor. Rutrum quisque non tellus orci ac.';

    section(class='py-12 tablet:py-16')
        div(class='wrapper max-w-4xl')
            header(class='mb-12 text-center')
                h1(class='text-h1 font-normal uppercase tracking-heading text-ink') FAQ Page
                p(class='mt-3 text-base text-ink-soft') Find answers to the most common questions

            div(class='rounded-card border border-line bg-white p-6 tablet:p-10')
                div(class='space-y-8')
                    each q in faqList
                        div
                            h3(class='text-lg font-semibold uppercase tracking-heading text-ink')= q
                            p(class='mt-2 text-base leading-relaxed text-ink-soft')= faqAnswer
