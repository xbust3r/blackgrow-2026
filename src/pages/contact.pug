extends ../layouts/main-template

block vars
    - const header = true;
    - const footer = true;
    - var currentUrl = 'contact.html';

block title
    title Contact Us — Blackgrow

block description
    meta(name='description', content='Contact Us — Blackgrow.')

block content
    section(class='py-12 tablet:py-16')
        div(class='wrapper')
            header(class='mb-12 text-center')
                h1(class='text-h1 font-normal uppercase tracking-heading text-ink') Happy to answer all your questions
                p(class='mx-auto mt-3 max-w-xl text-base text-ink-soft') Cursus mattis molestie a iaculis at erat pellentesque adipiscing. Ipsum faucibus vitae aliquet ullamcor si Tempus quam pellentesque nec nam aliquam.

            div(class='grid gap-12 desktop:grid-cols-[1fr_2fr]')
                div(class='space-y-6 rounded-card border border-line bg-surface-alt p-6 tablet:p-8')
                    h2(class='text-h3 font-medium uppercase tracking-heading text-ink') Where to find us?
                    p(class='text-sm leading-relaxed text-ink-soft') Cursus mattis molestie a iaculis at erat pellentesque adipiscing.

                    div(class='space-y-4 border-t border-line pt-6 text-sm')
                        div
                            h3(class='font-semibold uppercase tracking-heading text-ink') Address
                            p(class='mt-1 text-ink-soft') Store location pending definitive address
                        div
                            h3(class='font-semibold uppercase tracking-heading text-ink') Phone
                            p(class='mt-1 text-ink-soft') +1 (555) 000-0000
                        div
                            h3(class='font-semibold uppercase tracking-heading text-ink') Email
                            p(class='mt-1 text-ink-soft') info@example.com
                        div
                            h3(class='font-semibold uppercase tracking-heading text-ink') Hours
                            p(class='mt-1 text-ink-soft') Mon – Fri: 9:00 AM – 6:00 PM

                div(class='rounded-card border border-line bg-white p-6 tablet:p-8')
                    h2(class='mb-6 text-h3 font-medium uppercase tracking-heading text-ink') Contact Us
                    include ../components/contact-form

            div(class='mt-16')
                include ../components/google-map
