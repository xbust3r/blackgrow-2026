include media

mixin specList()
    dl(class='space-y-5')
        each row in [1, 2, 3]
            div(class='flex justify-between gap-5 border-b border-line pb-5 text-lg')
                dt(class='font-medium text-ink') title
                dd value

section(class='wrapper py-10')
    nav(aria-label='Product information')
        ul(class='flex flex-col justify-around gap-5 py-5 text-center text-h3 text-ink tablet:flex-row')
            each label in ['Description', 'Additional Information', 'Reviews (0)']
                li
                    a(href='#')= label
    div(class='grid items-center gap-10 rounded-card border border-line p-5 tablet:grid-cols-2 tablet:p-12')
        div
            h2(class='mb-5 text-h3 font-normal text-ink') Description
            p Quidem eveniet quod veritatis non. Dolore voluptas quod cumque sunt quia facere voluptas. Omnis nihil ad quia de bitis voluptatems of unique wholesale brand quidem eveniet quod veritatis non dolore voluptas quod cumque in.
        img(class='aspect-4/3 w-full rounded-card object-cover', src='/src/assets/images/box-description/description.webp', alt='', width='940', height='736', loading='lazy')
    div(class='mt-7 grid gap-10 rounded-card border border-line p-5 tablet:grid-cols-2 tablet:p-12')
        +specList()
        +specList()
