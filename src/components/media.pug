//- Marcadores de presentación. Las imágenes definitivas constan en el inventario.
mixin pendingImage(label, classes = '')
    div(class='relative flex items-center justify-center overflow-hidden border border-dashed border-line bg-surface-alt ' + classes, role='img', aria-label=label + ' — image pending')
        span(class='px-3 py-2 text-center text-xs uppercase tracking-heading text-ink-soft')= label + ' / image pending'

mixin heading(text, level = 'h2', classes = '')
    #{level}(class='text-h2 font-normal uppercase tracking-heading text-ink ' + classes)= text

mixin textLink(text, href = '#')
    a(class='inline-flex border-b border-brand pb-2 text-sm font-medium uppercase tracking-heading text-brand', href=href)= text

//- Botón de tienda. `as: 'button'` lo convierte en botón; `href` sólo aplica al
//- enlace y por defecto sigue siendo `#`, que es lo que traía el origen.
mixin shopButton(text, as = 'a', href = '#')
    if as === 'a'
        a(class='inline-flex items-center justify-center bg-brand px-9 py-5 text-sm font-medium uppercase tracking-heading text-white hover:bg-brand-strong', href=href)= text
    else
        button(class='inline-flex items-center justify-center bg-brand px-9 py-5 text-sm font-medium uppercase tracking-heading text-white hover:bg-brand-strong', type='button')= text

//- Variante secundaria: mismo botón sobre el color de acento. El panel del
//- carrito del origen empareja así «View cart» con «Checkout».
mixin shopButtonAlt(text, as = 'a', href = '#')
    if as === 'a'
        a(class='inline-flex items-center justify-center bg-accent px-9 py-5 text-sm font-medium uppercase tracking-heading text-ink hover:bg-accent-strong', href=href)= text
    else
        button(class='inline-flex items-center justify-center bg-accent px-9 py-5 text-sm font-medium uppercase tracking-heading text-ink hover:bg-accent-strong', type='button')= text

//- Selector de cantidad reutilizable con hook js-quantity
mixin quantityField(id, productName, value = 1)
    div(class='js-quantity inline-flex items-center whitespace-nowrap')
        button(class='js-quantity-down inline-flex size-11 items-center justify-center text-ink hover:text-brand', type='button')
            span(aria-hidden='true') &minus;
            span(class='sr-only') Decrease quantity of #{productName}
        label(class='sr-only', for=id) Quantity of #{productName}
        input(
            id=id,
            class='js-only-numbers w-15 rounded-field border border-line bg-white px-2.5 py-3 text-center text-h4 font-normal text-ink',
            name='quantity',
            type='number',
            inputmode='numeric',
            min='1',
            step='1',
            value=value
            )
        button(class='js-quantity-up inline-flex size-11 items-center justify-center text-ink hover:text-brand', type='button')
            span(aria-hidden='true') +
            span(class='sr-only') Increase quantity of #{productName}

