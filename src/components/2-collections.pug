include media

mixin collectionCard(index)
    article(class='p-2.5 text-center')
        a(class='block', href='./cart.html', aria-label='Collection 2 image')
            img(class='mx-auto aspect-[800/1100] w-full max-w-sm object-cover', src='/src/assets/images/collections/collection-' + index + '.webp', alt='', width='800', height='1100', loading='lazy')
        h2(class='my-2.5 text-h3 font-normal text-ink') Collection 2
        p(class='mb-2.5') this is a littele description of the collection
        +textLink('View Collection', './cart.html')

section(class='wrapper grid justify-center gap-5 py-5 tablet:grid-cols-2')
    each index in [1, 2]
        +collectionCard(index)
