include cart-side-area
include header-icons-row

header
    div(class='js-sticky-header fixed inset-x-0 top-0 z-40 hidden min-h-16 -translate-y-full items-center justify-between border-b border-line bg-surface/95 px-5 shadow-sm backdrop-blur transition-transform duration-300 tablet:flex', inert)
        a(class='text-xl font-medium uppercase tracking-heading text-brand', href='./index.html')= brand.name
        nav(aria-label='Sticky navigation')
            ul(class='flex flex-wrap gap-8')
                each group in siteNavigation
                    - var isExact = currentUrl === group.file;
                    - var isSection = group.items && group.items.some(function(item) { return item.file === currentUrl; });
                    - var groupAriaCurrent = isExact ? 'page' : (isSection ? 'true' : false);
                    li
                        a(
                            class='nav-link text-sm uppercase tracking-heading hover:text-brand',
                            href=group.url,
                            aria-current=groupAriaCurrent
                        )= group.title
        div(class='flex items-center gap-1')
            button(class='js-search-toggle inline-flex size-11 items-center justify-center text-ink hover:text-brand', type='button', aria-haspopup='dialog', aria-expanded='false', aria-controls='search-overlay', aria-label='Open search')
                +svgIcon('search', 'size-4 text-brand')
            +cartSideAreaOpener(cartCount)
    div(class='hidden min-h-17 items-center justify-between gap-5 bg-surface-alt px-5 text-ink tablet:flex')
        a(class='text-xl font-medium uppercase tracking-heading text-brand', href='./index.html')= brand.name
        nav(aria-label='Main navigation')
            ul(class='flex flex-wrap gap-8 wide:gap-16')
                each group in siteNavigation
                    - var isExact = currentUrl === group.file;
                    - var isSection = group.items && group.items.some(function(item) { return item.file === currentUrl; });
                    - var groupAriaCurrent = isExact ? 'page' : (isSection ? 'true' : false);
                    li
                        a(
                            class='nav-link text-sm uppercase tracking-heading hover:text-brand',
                            href=group.url,
                            aria-current=groupAriaCurrent
                        )= group.title
        div(class='flex items-center gap-4')
            button(class='js-subscribe-popup hidden items-center gap-2 text-sm uppercase tracking-heading hover:text-brand desktop:inline-flex', type='button', aria-haspopup='dialog', aria-expanded='false', aria-controls='subscribe-dialog')
                +svgIcon('mail', 'size-4 text-brand')
                | Newsletter
            button(class='js-search-toggle inline-flex items-center gap-2 text-sm uppercase tracking-heading hover:text-brand', type='button', aria-haspopup='dialog', aria-expanded='false', aria-controls='search-overlay', aria-label='Open search')
                +svgIcon('search', 'size-4 text-brand')
                | Search
            +cartSideAreaOpener(cartCount)
    if currentUrl === 'index.html' || isHome || headerIcons
        +headerIconsRow(cartCount, cartPreviewTotal)
    div(class='flex min-h-16 items-center justify-between gap-5 border-b border-line px-5 tablet:hidden')
        a(class='text-xl font-medium uppercase tracking-heading text-brand', href='./index.html')= brand.name
        div(class='flex items-center gap-1')
            button(class='js-search-toggle inline-flex size-11 items-center justify-center text-ink hover:text-brand', type='button', aria-haspopup='dialog', aria-expanded='false', aria-controls='search-overlay', aria-label='Open search')
                +svgIcon('search', 'size-5')
            +cartSideAreaOpener(cartCount)
            button(class='js-menu-toggle inline-flex size-11 items-center justify-center text-ink', type='button', aria-expanded='false', aria-controls='mobile-navigation', aria-label='Open menu')
                +svgIcon('menu', 'size-7')
    div(id='mobile-navigation', class='js-mobile-menu fixed inset-0 z-50 overflow-y-auto bg-surface p-6', role='dialog', aria-modal='true', aria-label='Main navigation', hidden)
        button(class='js-menu-close mb-10 flex min-h-11 items-center gap-2 text-ink', type='button')
            +svgIcon('close', 'size-6')
            | Close menu
        nav(aria-label='Mobile navigation')
            ul(class='space-y-6')
                each group in siteNavigation
                    li(class='space-y-3')
                        p(class='text-xs font-semibold uppercase tracking-wider text-ink-soft')= group.title
                        ul(class='space-y-2')
                            each item in group.items
                                li
                                    a(
                                        class='nav-link text-lg uppercase tracking-heading text-ink hover:text-brand',
                                        href=item.url,
                                        aria-current=(currentUrl === item.file ? 'page' : false)
                                    )= item.label

//- El panel del carrito vive fuera de la cabecera visible: es un diálogo a
//- pantalla completa por la derecha, y anidarlo dentro de la barra lo ataría al
//- apilado de ésta.
+cartSideArea(cartPreview, cartPreviewTotal)

include search-overlay

div(id='subscribe-dialog', class='js-subscribe-dialog fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4', role='dialog', aria-modal='true', aria-labelledby='subscribe-title', hidden)
    div(class='relative w-full max-w-lg rounded-card border border-line bg-surface p-8 shadow-card')
        button(class='js-subscribe-close absolute top-5 right-5 inline-flex size-11 items-center justify-center text-ink hover:text-brand', type='button', aria-label='Close newsletter')
            +svgIcon('close', 'size-5')
        h2(id='subscribe-title', class='text-center text-h2 font-normal uppercase tracking-heading text-ink') Newsletter
        p(class='mt-3 text-center text-ink-soft') Subscribe to our newsletter and get 10% off your first purchase
        form(class='js-form js-newsletter mt-6 space-y-5', aria-label='Newsletter subscription')
            +field({id: 'popup-newsletter-name', label: 'Your Name', name: form.firstName.name, autocomplete: 'given-name', placeholder: 'Your Name', filter: 'js-only-letters'})
            +field({id: 'popup-newsletter-email', label: 'Your Email', name: form.email.name, type: 'email', autocomplete: 'email', placeholder: 'Your Email'})
            +button('Subscribe', {type: 'submit', class: 'w-full rounded-none py-4 text-sm font-medium uppercase tracking-heading'})
            p(class='js-newsletter-status text-sm', role='status')

