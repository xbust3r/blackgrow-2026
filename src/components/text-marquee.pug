- var marqueeText = 'CLOTHES • TOYS • NURSERY • ACCESSORIES • BABY GEAR • '

section(class='overflow-hidden border-y border-line bg-surface-alt py-4', aria-label='Announcements')
    div(class='marquee-track select-none')
        span(class='inline-block px-4 text-sm font-medium uppercase tracking-heading text-ink')= marqueeText
        span(class='inline-block px-4 text-sm font-medium uppercase tracking-heading text-ink', aria-hidden='true')= marqueeText
        span(class='inline-block px-4 text-sm font-medium uppercase tracking-heading text-ink', aria-hidden='true')= marqueeText
        span(class='inline-block px-4 text-sm font-medium uppercase tracking-heading text-ink', aria-hidden='true')= marqueeText
