//- Segunda fila del header de la home: iconos ilustrados y logotipo centrado.
//- Visible exclusivamente en escritorio (hidden tablet:hidden desktop:block), tal como en el origen.

mixin headerIconsRow(cartItemCount = cartCount, cartTotal = cartPreviewTotal)
    div(class='hidden border-b border-line bg-surface py-5 desktop:block')
        div(class='wrapper flex items-center justify-between')
            //- Grupo izquierdo: New In y About Us
            div(class='flex items-center gap-12 wide:gap-20')
                a(
                    class='group flex flex-col items-center justify-center text-center',
                    href='./cart.html'
                )
                    div(class='flex h-header-icon items-center justify-center transition-transform duration-300 ease-out group-hover:-translate-y-1 motion-reduce:transform-none')
                        img(
                            class='h-header-icon w-auto',
                            src='/src/assets/images/header/rainbow.webp',
                            alt='',
                            width='98',
                            height='70',
                            loading='eager'
                        )
                    span(class='mt-3.5 text-sm font-normal uppercase tracking-heading text-ink transition-colors group-hover:text-brand') New In

                a(
                    class='group flex flex-col items-center justify-center text-center',
                    href='./page.html'
                )
                    div(class='flex h-header-icon items-center justify-center transition-transform duration-300 ease-out group-hover:-translate-y-1 motion-reduce:transform-none')
                        img(
                            class='h-header-icon w-auto',
                            src='/src/assets/images/header/star.webp',
                            alt='',
                            width='73',
                            height='70',
                            loading='eager'
                        )
                    span(class='mt-3.5 text-sm font-normal uppercase tracking-heading text-ink transition-colors group-hover:text-brand') About Us

            //- Logotipo central
            a(
                class='flex shrink-0 items-center justify-center px-4 transition-transform duration-300 ease-out hover:scale-[1.02] motion-reduce:transform-none',
                href='./index.html',
                aria-label=brand.name
            )
                img(
                    class='h-header-icon w-auto',
                    src='/src/assets/images/header/logo-img-1.webp',
                    alt='',
                    width='461',
                    height='140',
                    loading='eager'
                )

            //- Grupo derecho: Wishlist y Cart
            div(class='flex items-center gap-12 wide:gap-20')
                a(
                    class='group flex flex-col items-center justify-center text-center',
                    href='./wishlist.html'
                )
                    div(class='flex h-header-icon items-center justify-center transition-transform duration-300 ease-out group-hover:-translate-y-1 motion-reduce:transform-none')
                        img(
                            class='h-header-icon w-auto',
                            src='/src/assets/images/header/hearth.webp',
                            alt='',
                            width='56',
                            height='70',
                            loading='eager'
                        )
                    span(class='mt-3.5 text-sm font-normal uppercase tracking-heading text-ink transition-colors group-hover:text-brand') Wishlist

                a(
                    class='group flex flex-col items-center justify-center text-center',
                    href='./cart-page.html'
                )
                    div(class='relative flex h-header-icon items-center justify-center transition-transform duration-300 ease-out group-hover:-translate-y-1 motion-reduce:transform-none')
                        img(
                            class='h-header-icon w-auto',
                            src='/src/assets/images/header/cart-empty-large.webp',
                            alt='',
                            width='77',
                            height='70',
                            loading='eager'
                        )
                        span(class='absolute top-1.5 -right-2 flex size-7 items-center justify-center rounded-full border-2 border-surface bg-surface-alt text-xs font-medium text-ink')= cartItemCount
                    span(class='mt-3.5 text-sm font-normal uppercase tracking-heading text-ink transition-colors group-hover:text-brand') Cart #{cartTotal}
