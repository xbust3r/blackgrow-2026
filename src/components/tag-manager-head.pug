include config

//- El contenedor sale de `config.pug`. Sin id no se emite nada: un GTM copiado
//- de otro proyecto manda datos a la cuenta equivocada, y eso no se deshace.
if brand.gtm
    // Google Tag Manager
    script.
        (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', '#{brand.gtm}');
    // End Google Tag Manager
