include blog-card
include blog-sidebar
include pagination

mixin blogListTemplate(sidebar = 'right', cardLevel = 'h2', sidebarLevel = 'h2', sidebarPostLevel = 'h3')
    -
        const defaultBlogPosts = [
            { format: 'standard', title: 'A guide to packing travel clothes and necesetys for a family vacation', date: 'May 12, 2026', dateIso: '2026-05-12', author: 'by Saira Bishon', category: 'Care', image: '/src/assets/images/blog/article-a.webp', excerpt: 'Pretium fusce id velit ut tortor. Euismod quis viverra nibh cras pulvinar mattis nunc. Arc…' },
            { format: 'standard', title: 'Must have toys to carry with you to the seaside for a successful creative playtime', date: 'May 09, 2026', dateIso: '2026-05-09', author: 'by Saira Bishon', category: 'Play', image: '/src/assets/images/blog/article-b.webp', width: 1024, height: 1024, excerpt: 'Pretium fusce id velit ut tortor. Euismod quis viverra nibh cras pulvinar mattis nunc. Arc…' },
            { format: 'quote', quote: 'Tellus pellentesque eu tincidunt tortor an nua ali qu am facilisia crasoned ferment.', quoteAuthor: 'JULY, CALIFORNIA', date: 'May 04, 2026', dateIso: '2026-05-04', author: 'by Saira Bishon', category: 'Nurturing' },
            { format: 'standard', title: 'Create a safe space environment for your children to play in and be fulfilled inside', date: 'Apr 29, 2026', dateIso: '2026-04-29', author: 'by Saira Bishon', category: 'Nursery', image: '/src/assets/images/blog/article-a.webp', excerpt: 'Pretium fusce id velit ut tortor. Euismod quis viverra nibh cras pulvinar mattis nunc. Arc…' },
            { format: 'standard', title: 'Toys that bring kids joy and become their playful buddies for pretend play time', date: 'Apr 22, 2026', dateIso: '2026-04-22', author: 'by Saira Bishon', category: 'Toys', image: '/src/assets/images/blog/article-b.webp', width: 1024, height: 1024, excerpt: 'Pretium fusce id velit ut tortor. Euismod quis viverra nibh cras pulvinar mattis nunc. Arc…' }
        ];

    section(class='py-12 tablet:py-16')
        div(class='wrapper')
            header(class='mb-10 text-center')
                h1(class='text-h1 font-normal uppercase tracking-heading text-ink') Our Blog
                p(class='mt-2 text-base text-ink-soft') Pretium fusce id velit ut tortor. Euismod quis viverra nibh cras pulvinar mattis nunc.

            if sidebar === 'right'
                div(class='grid gap-10 desktop:grid-cols-[1fr_320px]')
                    div(class='space-y-8')
                        each post in defaultBlogPosts
                            +blogCard(post, cardLevel)
                        +pagination(1, 3)
                    div
                        +blogSidebar(sidebarLevel, sidebarPostLevel)
            else if sidebar === 'left'
                div(class='grid gap-10 desktop:grid-cols-[320px_1fr]')
                    div(class='order-2 desktop:order-1')
                        +blogSidebar(sidebarLevel, sidebarPostLevel)
                    div(class='order-1 space-y-8 desktop:order-2')
                        each post in defaultBlogPosts
                            +blogCard(post, cardLevel)
                        +pagination(1, 3)
            else
                div(class='mx-auto max-w-4xl space-y-8')
                    each post in defaultBlogPosts
                        +blogCard(post, cardLevel)
                    +pagination(1, 3)
