include blog-card
include blog-sidebar
include pagination

mixin blogListTemplate(sidebar = 'right')
    -
        const defaultBlogPosts = [
            { format: 'standard', title: 'Sustainable Nursery Essentials for Growing Families', date: 'May 12, 2026', dateIso: '2026-05-12', author: 'Emily Miller', category: 'Nursery', image: '/src/assets/images/blog/article-a.webp', excerpt: 'Discover eco-friendly materials and thoughtful design choices that make parenting simpler and spaces cozier.' },
            { format: 'quote', quote: 'Simplicity and safety are at the heart of conscious parenting.', quoteAuthor: 'Maria Montessori', date: 'May 09, 2026', dateIso: '2026-05-09', author: 'Team', category: 'Inspiration' },
            { format: 'gallery', title: 'Curating a Calm and Clutter-Free Baby Space', date: 'May 04, 2026', dateIso: '2026-05-04', author: 'David Chen', category: 'Design', image: '/src/assets/images/blog/article-a.webp', imageB: '/src/assets/images/blog/article-b.webp', excerpt: 'A visual walkthrough of modern wooden cribs, soft pastel textiles, and functional storage setups.' },
            { format: 'link', linkText: 'Explore Certified Organic GOTS Cotton Standards', linkUrl: '#', date: 'Apr 29, 2026', dateIso: '2026-04-29', author: 'Research Team', category: 'Materials' },
            { format: 'standard', title: 'Natural Wooden Toys That Grow With Your Child', date: 'Apr 22, 2026', dateIso: '2026-04-22', author: 'Sarah Jenkins', category: 'Playtime', image: '/src/assets/images/blog/article-b.webp', excerpt: 'Why open-ended wooden toys inspire richer creativity and last across multiple siblings.' }
        ];

    section(class='py-12 tablet:py-16')
        div(class='wrapper')
            header(class='mb-10 text-center')
                h1(class='text-h1 font-normal uppercase tracking-heading text-ink') Our Blog
                p(class='mt-2 text-base text-ink-soft') Stories, tips and inspiration for conscious parents

            if sidebar === 'right'
                div(class='grid gap-10 desktop:grid-cols-[1fr_320px]')
                    div(class='space-y-8')
                        each post in defaultBlogPosts
                            +blogCard(post)
                        +pagination(1, 3)
                    div
                        +blogSidebar()
            else if sidebar === 'left'
                div(class='grid gap-10 desktop:grid-cols-[320px_1fr]')
                    div(class='order-2 desktop:order-1')
                        +blogSidebar()
                    div(class='order-1 space-y-8 desktop:order-2')
                        each post in defaultBlogPosts
                            +blogCard(post)
                        +pagination(1, 3)
            else
                div(class='mx-auto max-w-4xl space-y-8')
                    each post in defaultBlogPosts
                        +blogCard(post)
                    +pagination(1, 3)
