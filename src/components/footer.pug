footer(class='border-t border-line')
    div(class='wrapper grid gap-6 py-5 tablet:grid-cols-4')
        each group in siteNavigation
            div
                h2(class='my-5 text-base font-normal uppercase tracking-heading text-ink')= group.title
                ul(class='space-y-2')
                    each item in group.items
                        - var isCurrent = currentUrl === item.file;
                        li
                            a(
                                class=['nav-link text-sm text-ink-soft hover:text-brand', isCurrent ? 'is-active' : ''],
                                href=item.url,
                                aria-current=(isCurrent ? 'page' : false)
                            )= item.label
    div(class='wrapper py-5')
        p= '© ' + brand.legalName

button(
    class='js-back-to-top pointer-events-none fixed right-8 bottom-8 z-30 inline-flex size-11 items-center justify-center rounded-full bg-brand text-white opacity-0 shadow-card transition-all duration-300 hover:bg-brand-strong focus-visible:pointer-events-auto focus-visible:opacity-100',
    type='button',
    aria-label='Back to top'
)
    span(class='text-lg font-bold', aria-hidden='true') ↑

