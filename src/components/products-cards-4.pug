include product-card

//- Las cuatro tarjetas del origen usan la misma foto de producto: se preserva esa repetición.
- var cardImage = { src: '/src/assets/images/products/card.webp', width: 768, height: 690 };

mixin productsCards4(level = 'h3')
    section(class='wrapper grid gap-5 py-5 desktop:grid-cols-4', aria-label='Products')
        each product in [{category: 'Crib', name: 'product name', price: '$ 99.00', image: cardImage}, {category: 'Crib', name: 'product name', price: '$ 99.00', image: cardImage}, {category: 'Crib', name: 'product name', price: '$ 99.00', image: cardImage}, {category: 'Crib', name: 'product name', price: '$ 99.00', image: cardImage}]
            +productCard(product, false, level)
