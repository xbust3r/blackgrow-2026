mixin shopList(cols = 3, showSidebar = (cols === 3))
    -
        var colMap = {
            3: 'desktop:grid-cols-3',
            4: 'desktop:grid-cols-4',
            5: 'desktop:grid-cols-5',
            6: 'desktop:grid-cols-6'
        };
        var colClass = colMap[cols] || 'desktop:grid-cols-3';

    section(class='wrapper py-10' + (showSidebar ? ' grid gap-10 desktop:grid-cols-4' : ''))
        if showSidebar
            aside(class='min-w-0 space-y-10', aria-label='Shop Sidebar')
                div
                    h2(class='mb-6 text-h3 font-normal text-ink') Categories
                    ul(class='space-y-3 text-base')
                        each cat in shopCategories
                            li
                                a(class='flex items-center justify-between text-ink hover:text-brand', href='./cart.html')
                                    span= cat.name
                                    span(class='text-ink-soft')
                                        span(aria-hidden='true')= cat.count
                                        span(class='sr-only')= ' ' + cat.count + ' products'

                div
                    h2(class='mb-6 text-h3 font-normal text-ink') Popular products
                    ul(class='space-y-4')
                        each pop in popularProducts
                            li
                                a(class='group flex items-center gap-4', href='./cart-index.html')
                                    img(class='size-16 shrink-0 rounded-field object-cover', src=pop.image.src, alt='', width=pop.image.width, height=pop.image.height, loading='lazy')
                                    div(class='min-w-0')
                                        h3(class='text-base font-normal text-ink group-hover:text-brand')= pop.name
                                        p(class='mt-1 text-sm text-ink-soft')= pop.price

                div
                    h2(class='mb-6 text-h3 font-normal text-ink') Filter by price
                    div(class='space-y-4', role='group', aria-label='Filter by price')
                        div(class='relative h-1.5 w-full rounded-full bg-line')
                            div(class='absolute inset-y-0 start-0 w-full rounded-full bg-brand')
                        div(class='flex items-center justify-between text-sm')
                            span(class='text-ink-soft') Price: 
                                span(class='font-medium text-ink') $20.00
                                |  — 
                                span(class='font-medium text-ink') $500.00
                            button(class='inline-flex items-center justify-center rounded-field bg-brand px-4 py-1.5 text-xs font-medium uppercase tracking-heading text-white transition-colors hover:bg-brand-strong disabled:cursor-not-allowed disabled:opacity-60', type='button', disabled, title='Presentation only') Apply

        div(class='min-w-0' + (showSidebar ? ' desktop:col-span-3' : ''))
            div(class='mb-8 flex flex-col gap-4 tablet:flex-row tablet:items-center tablet:justify-between')
                p(class='text-base text-ink-soft') Showing 1–12 of 50 results
                form(class='flex items-center gap-2', action='#', method='get')
                    label(class='sr-only', for='shop-order-' + cols) Shop order
                    select(id='shop-order-' + cols, name='orderby', class='rounded-field border border-line bg-surface px-3 py-2 text-sm text-ink focus-visible:border-brand', aria-label='Shop order')
                        option(value='menu_order', selected) Default sorting
                        option(value='popularity') Sort by popularity
                        option(value='rating') Sort by average rating
                        option(value='date') Sort by latest
                        option(value='price') Sort by price: low to high
                        option(value='price-desc') Sort by price: high to low

            div(class='grid gap-5 tablet:grid-cols-2 ' + colClass)
                each product in shopProducts
                    +productCard(product, true)

            div(class='mt-8')
                +pagination(1, 5, './cart.html', 'Shop Pagination')
