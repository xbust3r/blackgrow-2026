include ui

mixin iconWithText(item, level = 'h3')
    div(class='flex flex-col items-center text-center' + (item.class ? ' ' + item.class : ''))
        div(class='mb-4 flex size-16 items-center justify-center rounded-full bg-surface-alt text-brand')
            +svgIcon(item.icon || 'star', 'size-8')
        #{level}(class='mb-2 text-h4 font-medium uppercase tracking-heading text-ink')= item.title
        p(class='max-w-xs text-sm text-ink-soft')= item.text

-
    var defaultFeatures = [
        { icon: 'star', title: 'Title', text: 'Cursus mattis molestie a iaculis at erat pellentesque adipiscing isu faucibus vitae aliquet.' },
        { icon: 'cart', title: 'Free delivery', text: 'Cursus mattis molestie a iaculis at erat pellentesque adipiscing isu faucibus vitae aliquet.' },
        { icon: 'mail', title: 'Support', text: 'Cursus mattis molestie a iaculis at erat pellentesque adipiscing isu faucibus vitae aliquet.' }
    ]

mixin featuresSection(level = 'h2', itemLevel = 'h3', sectionTitle = 'Features')
    section(class='py-12 tablet:py-16', aria-label=sectionTitle)
        if sectionTitle
            #{level}(class='sr-only')= sectionTitle
        div(class='wrapper grid gap-8 tablet:grid-cols-3')
            each item in defaultFeatures
                +iconWithText(item, itemLevel)

+featuresSection(featuresSectionLevel || 'h2', featuresItemLevel || 'h3', featuresSectionTitle !== undefined ? featuresSectionTitle : 'Features')
