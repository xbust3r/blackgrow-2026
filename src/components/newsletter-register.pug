include media

section(class='relative tablet:grid tablet:min-h-hero tablet:items-center tablet:py-12')
    div(class='absolute inset-0 hidden tablet:block')
        img(class='size-full object-cover', src='/src/assets/images/newsletter/background.webp', alt='', width='2560', height='1005', loading='lazy')
    div(class='relative max-w-xl bg-white p-5 tablet:ms-[20%] tablet:p-10')
        +heading('Newsletter', 'h2', 'text-center')
        p(class='mt-3 text-center text-lg') Subscribe to our newsletter and get 10% off your first purchase
        form(class='js-newsletter mt-5 space-y-5', aria-label='Newsletter')
            +field({id: 'newsletter-name', label: 'Your Name', name: form.firstName.name, autocomplete: 'given-name', placeholder: 'Your Name'})
            +field({id: 'newsletter-email', label: 'Your Email', name: form.email.name, type: 'email', autocomplete: 'email', placeholder: 'Your Email'})
            +button('Subscribe', {type: 'submit', class: 'w-full rounded-none py-5 text-sm font-medium uppercase tracking-heading'})
            p(class='js-newsletter-status text-sm', role='status')
